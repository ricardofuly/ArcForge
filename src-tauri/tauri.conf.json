{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcForge",
  "version": "0.1.4",
  "identifier": "com.fulygames.unreal-launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArcForge",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: asset: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' https: ipc: http://ipc.localhost http://127.0.0.1:*;"
    }

  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Launcher para gerenciar instalações da Unreal Engine e projetos no Linux e Windows",
    "longDescription": "Launcher nativo e leve para gerenciar instalações da Unreal Engine, projetos C++/Blueprint, dependências e assets no Linux e Windows.",
    "publisher": "Ricardo Fuly",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1",
          "librsvg2-2",
          "libssl3 | libssl1.1"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
